# Backend reference — NOT an nginx site block.
#
# The API runs as a Node process (PM2), not as files served by nginx.
#
# Process:
#   cd /var/www/viso/backend
#   cp .env.example .env   # fill GEMINI_API_KEY, RESEND_*, etc.
#   npm install            # from repo root once: cd /var/www/viso && npm install
#   npm run pm2:backend
#
# Listens on: 127.0.0.1:8787 (override with BACKEND_DEV_PORT in backend/.env)
#
# Routes:
#   POST /api/chat
#   POST /api/send-email
#
# nginx proxies /api/ from frontend + admin vhosts to this port via viso-upstream.conf
#
# Verify:
#   pm2 status
#   pm2 logs viso-api
#   curl -s -o /dev/null -w "%{http_code}\n" http://127.0.0.1:8787/api/chat

BACKEND_DEV_PORT=8787
