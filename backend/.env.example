# Copy to `backend/.env` (gitignored). All sensitive / API keys live here only.
# Netlify production: set the same variable names in the main site (functions runtime).

# --- Chat (`POST /api/chat`) ---
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-flash"

# --- Email (`POST /api/send-email`) ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="VISO Group <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="info@visogroup.com"
HR_NOTIFICATION_EMAIL="hr@visogroup.com"

# Optional aliases: ADMIN_EMAIL, HR_EMAIL

# --- Optional integrations (server-only; add code before using in the app) ---
# OPENAI_API_KEY=""
# SAMBANOVA_API_KEY=""
# GOOGLE_MAPS_API_KEY=""

# --- Local API server (`npm run dev:backend`, default port 8787) ---
# BACKEND_DEV_PORT=8787
