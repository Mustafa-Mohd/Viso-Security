{
  "name": "viso",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w @viso/frontend",
    "dev:frontend": "npm run dev -w @viso/frontend",
    "dev:admin": "npm run dev -w @viso/admin",
    "dev:backend": "npm run dev -w @viso/backend",
    "build": "npm run build -w @viso/frontend",
    "build:frontend": "npm run build -w @viso/frontend",
    "build:admin": "npm run build -w @viso/admin",
    "build:backend": "npm run build -w @viso/backend",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop viso-api",
    "pm2:restart": "pm2 restart viso-api",
    "pm2:logs": "pm2 logs viso-api",
    "pm2:delete": "pm2 delete viso-api",
    "lint": "npm run lint -w @viso/frontend && npm run lint -w @viso/admin",
    "format": "npm run format -w @viso/frontend"
  },
  "dependencies": {
    "i": "^0.3.7"
  }
}
