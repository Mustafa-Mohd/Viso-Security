# Copy to repo root `.env` (not inside frontend/). Only public `VITE_*` values belong here.
# Secrets → `backend/.env` (see backend/.env.example).

VITE_ADMIN_APP_URL="http://localhost:5174"

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Optional: point at `npm run dev:backend` (default port 8787). Leave unset to use built-in Vite /api/* dev handlers.
# VITE_API_URL="http://localhost:8787"

# Server API keys live in `backend/.env` (not here).
